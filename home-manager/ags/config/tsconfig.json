{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "astal/gtk3",
    "paths": {
      "astal": ["./node_modules/astal/gtk3"],
      "astal/*": ["./node_modules/astal/*"]
    },
    "skipLibCheck": true
  },
  "include": ["./**/*"]
}
